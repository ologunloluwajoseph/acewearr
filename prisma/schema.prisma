// AceWears — Prisma schema (PostgreSQL — production-ready for Vercel)
// To revert to local SQLite dev: cp prisma/schema.sqlite.bak.prisma prisma/schema.prisma && npx prisma generate

generator client {
  provider      = "prisma-client-js"
  // Vercel serverless uses debian-openssl-3.0.x; local dev uses native.
  // Both are listed so the same generated client works in both environments.
  binaryTargets  = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== Identity & Accounts ======
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  phone         String?
  role          String   @default("CUSTOMER") // CUSTOMER | ADMIN | STAFF | SELLER
  isPremium     Boolean  @default(false) // gates AI Virtual Try-On
  premiumSince  DateTime?
  // Multi-vendor: seller-specific fields
  isSeller      Boolean  @default(false)
  storeName     String?
  storeSlug     String?
  commissionRate Float  @default(10.0) // default 10% commission
  sellerBalanceCents Int @default(0) // pending payout balance
  heightCm      Int?
  weightKg      Int?
  fitPreference String?  // SLIM | REGULAR | RELAXED
  // Credit system — every product carries a 500 NGN surcharge that accumulates
  // as the user's credit eligibility limit. When they pay full price, the surcharge
  // portion unlocks buy-on-credit capacity.
  creditBalanceCents Int @default(0) // available credit to spend (accumulated surcharges)
  creditLimitCents   Int @default(0) // total lifetime credit limit earned
  creditUsedCents    Int @default(0) // credit currently owed (purchases on credit)
  // Currency + language preferences
  preferredCurrency  String   @default("USD") // USD | NGN | EUR | GBP
  preferredLanguage  String   @default("en") // en | fr | es | de | zh | yo | ha | ig
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cartItems     CartItem[]
  recentViews   RecentView[]
  tradeInItems  TradeInItem[]
  notifications Notification[]
  bodyProfile   BodyProfile?
  tryOnResults  TryOnResult[]
  wishlistItems WishlistItem[]
  creditTransactions CreditTransaction[]
  sellerProducts  Product[] @relation("SellerProducts")
}

// ====== Wishlist (public-by-default) ======
// Every user's wishlist is publicly viewable. Items can be shared with a
// custom caption + the user's profile photo via the ShareWishlistDialog.
model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  // Optional per-item note (the user's "words of suggestion" when sharing)
  note        String?
  // When this item was added to the wishlist
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ====== AI Body Profile (Premium feature) ======
// Stores the user's natural physical attributes used by the Virtual Try-On engine.
// `vlmExtractedAttrs` is a JSON blob populated by the VLM analysis of the uploaded photo.
model BodyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  // User-supplied (manual)
  skinTone        String?  // e.g. "deep", "tan", "olive", "fair", "porcelain"
  hairStyle        String?  // e.g. "short", "buzz", "afro", "curly-mid", "long-straight", "bob"
  hairColor        String?  // e.g. "black", "dark-brown", "auburn", "blonde", "gray"
  eyeColor        String?  // e.g. "brown", "hazel", "blue", "green"
  bodyType        String?  // ECTOMORPH | MESOMORPH | ENDOMORPH
    bustChestCm      Int?
  waistCm         Int?
  hipCm           Int?
  inseamCm        Int?
  shoulderCm      Int?
  // Uploaded images (URLs to /uploads/...)
  faceImageUrl    String?
  bodyImageUrl    String?
  // VLM-extracted structured attributes (JSON string)
  vlmExtractedAttrs String? // {"faceShape":"oval","jawLine":"defined","cheekbones":"high",...}
  // Privacy / consent
  consentToRender Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====== Try-On Result Cache ======
// Each (user, product) pair generates a rendered visualization — cached for reuse.
model TryOnResult {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  // Rendered image URL (stored in /public/uploads/try-on-<id>.png)
  resultUrl    String
  // The prompt that was sent to the image gen model (for audit)
  promptUsed   String
  // Generation metadata
  modelVersion String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  line1     String
  line2     String?
  city      String
  state     String?
  postal    String
  country   String   @default("NG")
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====== Catalog ======
model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  parentId String?
  parent   Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String
  basePriceCents Int
  currency     String         @default("USD")
  // Multi-vendor: which seller owns this product (null = AceWears own catalog)
  sellerId     String?
  seller       User?          @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: SetNull)
  // Credit surcharge — a percentage of the product price (default 3%)
  // that accumulates as the user's credit eligibility when they buy at full price.
  // Buy a $289 blazer → earn $8.67 credit. Buy a $79 belt → earn $2.37 credit.
  // The more expensive the product, the more credit earned. Hidden from regular users.
  creditSurchargePercent Float @default(3.0) // 3% of product price → credit earned
  material     String?
  fit          String? // SLIM | REGULAR | RELAXED | OVERSIZED
  care         String?
  tags         String         @default("")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  recentViews  RecentView[]
  reelItems    ReelItem[]
  tradeInItems TradeInItem[]
  sizeChart    SizeChartEntry[]
  promoTags    PromoTag[]
  tryOnResults TryOnResult[]
  wishlistItems WishlistItem[]
  creditTransactions CreditTransaction[]

  @@index([categoryId])
  @@index([isActive])
  @@index([fit])
}

// Multi-angle image uploader: 3 dedicated slots — FRONT, BACK, SIDE_DETAIL
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  angle     String   // FRONT | BACK | SIDE_DETAIL
  url       String
  altText   String?
  widthPx   Int?
  heightPx  Int?
  orderIdx  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, angle])
  @@index([orderIdx])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique
  size         String   // XS | S | M | L | XL | XXL | 30 | 32 | 34 ...
  color        String?
  stockCount   Int      @default(0)
  priceOverrideCents Int?
  isActive     Boolean  @default(true)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, size])
  @@index([sku])
}

model SizeChartEntry {
  id         String  @id @default(cuid())
  productId  String
  size       String
  chestCm    Int
  waistCm    Int
  hipCm      Int?
  lengthCm   Int?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ====== Cart & Orders ======
model CartItem {
  id         String         @id @default(cuid())
  userId     String
  productId  String
  variantId  String?
  quantity   Int            @default(1)
  savedForLater Boolean     @default(false)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  status          String      @default("PENDING") // PENDING | PAID | FULFILLED | DELIVERED | CANCELLED | RETURNED
  subtotalCents   Int
  shippingCents   Int         @default(0)
  discountCents   Int         @default(0)
  totalCents      Int
  currency        String      @default("USD")
  trackingNumber  String?
  placedAt        DateTime    @default(now())
  deliveredAt     DateTime?
  user            User        @relation(fields: [userId], references: [id])

  items           OrderItem[]

  @@index([userId, status])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  titleSnapshot   String
  priceCents      Int
  quantity        Int
  sizeSnapshot    String?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  reviewEligible  Boolean  @default(true) // gates review submission
  review          Review?

  @@index([orderId])
  @@index([productId])
}

// ====== Verified Reviews ======
// Review must reference an OrderItem whose Order.status == "DELIVERED"
model Review {
  id           String        @id @default(cuid())
  userId       String
  productId    String
  orderItemId  String        @unique // one review per order line — guaranteed "Verified Buyer"
  rating       Int           // 1..5
  title        String?
  body         String
  fitTags      String        @default("") // CSV: fit_true_to_size,runs_small,quality_high...
  isVerified   Boolean       @default(true)
  isHidden     Boolean       @default(false)
  helpfulCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
  photos       ReviewPhoto[]

  @@index([productId, isHidden, createdAt])
  @@index([userId])
}

model ReviewPhoto {
  id        String  @id @default(cuid())
  reviewId  String
  url       String
  orderIdx  Int     @default(0)
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ====== Reels (Shoppable short-video feed) ======
model ReelItem {
  id         String   @id @default(cuid())
  videoUrl   String
  posterUrl  String?
  title      String
  caption    String?
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  isActive   Boolean  @default(true)

  @@index([productId])
  @@index([isActive, createdAt])
}

// ====== Retention ======
model RecentView {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // ORDER_SHIPPED | RESTOCK | DEAL_TIMER | TRADE_IN_CREDIT
  title     String
  body      String
  data      String   @default("{}") // JSON payload
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ====== Re-Commerce / Trade-In ======
model TradeInItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  condition     String   // NEW | LIKE_NEW | GOOD | WORN
  ageMonths     Int?
  claimedCreditCents Int @default(0)
  status        String   @default("SUBMITTED") // SUBMITTED | INSPECTED | APPROVED | CREDITED | REJECTED
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  @@index([userId, status])
}

// ====== Promo / Scarcity ======
model PromoTag {
  id        String   @id @default(cuid())
  productId String
  label     String   // e.g. "Only 2 left in Size L"
  kind      String   // SCARCITY | COUNTDOWN | FEATURED
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  isActive  Boolean  @default(true)
  payload   String   @default("{}")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
}

// ====== Credit System ======
// Every product carries a creditSurchargePercent (default 3% of price).
// When a customer pays full price, the surcharge amount (price * percent / 100)
// is credited to their creditBalanceCents — accumulating as buy-on-credit
// eligibility. They can then spend up to creditBalanceCents on future
// purchases on credit (pay later), tracked as creditUsedCents.
// Credit starts at ZERO and grows based on what they buy and the price.
model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  productId   String?
  // EARNED | USED | REPAID | ADJUSTED
  type        String
  // Amount in cents. Positive for EARNED/REPAID, negative for USED.
  amountCents Int
  // Running balance after this transaction (for audit trail)
  balanceAfterCents Int
  // Human-readable description
  description String
  // Optional reference to the order that triggered this transaction
  orderId     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
}
